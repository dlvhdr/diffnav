-
-    if (c < 0x20 || c == 0x7f || c >= 0x80) {
-      return;
-    }
-
-    if (table->chars[c]) {
-      cp[(*cpi)++] = table->chars[c];
-    } else {
-      cp[(*cpi)++] = c;
-    }
-  }
