-static void tab(VTermState *state, int count, int direction)
-{
-  while (count > 0) {
-    if (direction > 0) {
-      if (state->pos.col >= THISROWWIDTH(state) - 1) {
-        return;
-      }
-
-      state->pos.col++;
-    } else if (direction < 0) {
-      if (state->pos.col < 1) {
-        return;
-      }
-
-      state->pos.col--;
-    }
-
-    if (is_col_tabstop(state, state->pos.col)) {
-      count--;
-    }
-  }
-}
